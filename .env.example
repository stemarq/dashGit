# Token pessoal do GitLab com escopo read_api
# Crie em: https://gitlab.com/-/user_settings/personal_access_tokens
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# Base da API (troque se for self-hosted: https://gitlab.suaempresa.com/api/v4)
GITLAB_API_URL=https://gitlab.com/api/v4

# Projetos padrao do dashboard (separados por virgula).
# Aceita "grupo/subgrupo/projeto" ou o ID numerico.
DEFAULT_PROJECTS=meu-grupo/meu-projeto

# Caminho do cache SQLite
DATABASE_PATH=./dashgit.db

# Requisicoes simultaneas contra a API do GitLab
MAX_CONCURRENCY=8

# Colunas que NAO contam como tempo de trabalho (fila de planejamento).
# Elas somem de todos os graficos e somas. Separadas por virgula.
EXCLUDED_LABELS=Backlog

# Coluna que representa trabalho em andamento, usada para ranquear as issues
# mais demoradas. Deixe vazio para o dash detectar sozinho (procura por
# Doing / Em andamento / In progress).
FOCUS_LABEL=Doing

# Faixas do dia que NAO sao tempo de trabalho (aula, almoco), no formato
# HH:MM-HH:MM e separadas por virgula. Vazio = o dia inteiro conta.
# Ex.: NON_WORKING_HOURS=10:00-14:00
NON_WORKING_HOURS=

# Sabado e domingo nao contam como tempo em nenhuma metrica (coluna, fila,
# lead time, espera causada). O fim de semana e avaliado no fuso da maquina.
SKIP_WEEKENDS=true

# Commits de quem nao e do time (bot do template, professor, convidado) ficam
# fora de toda metrica de commit por padrao. O que sobrou de fora aparece como
# nota nas telas e nos relatorios, nunca some calado.
COUNT_NON_MEMBERS=false

# Coluna de revisao, usada para medir quanto tempo cada pessoa passou
# revisando. Deixe vazio para detectar sozinho (Review / Revisao / QA).
# Nunca e uma coluna de QUEUE_LABELS: fila e espera, nao revisao.
REVIEW_LABEL=

# De quem e o tempo de cada coluna:
#   mover    = quem moveu o card para la. O executor leva o Doing, o revisor
#              leva o Review. E o padrao.
#   assignee = tudo vai para o responsavel atual da issue.
ATTRIBUTION=mover

# Que issues contam no tempo de uma pessoa:
#   assigned = so as issues atribuidas a ela (padrao)
#   touched  = qualquer issue em que ela fez alguma etapa
SCOPE=assigned

# Colunas de espera (fila). O card fica la parado esperando alguem pegar:
# o tempo aparece na analise de gargalo, mas nao entra no tempo de ninguem.
# Ex.: QUEUE_LABELS=Waiting Review
QUEUE_LABELS=
